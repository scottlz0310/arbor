<?xml version="1.0" encoding="utf-8"?>
<!-- {VERSION} は Build-Msix.ps1 がタグから生成する 4 要素バージョンに置換する -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 desktop rescap">

  <Identity
    Name="scottlz0310.arbor"
    Publisher="CN=scottlz0310"
    Version="{VERSION}"
    ProcessorArchitecture="x64" />

  <!--
    書き込み仮想化は、既定（有効）のままにする。新しく作られるファイル（WebView2 のデータなど）が、
    パッケージ専用領域（%LOCALAPPDATA%\Packages\...\LocalCache）に入り、アンインストールで消える。
    dsx のように無効化しないのは、dsx が go / npm / winget / scoop などのグローバルツールを更新する
    （結果を他のシェルから見える場所へ書く）のに対し、Arbor は、それらを dsx（自身のパッケージで無効化している）
    に任せ、自身は %APPDATA% 配下へ書かないため。実機で、有効のまま、doctor・Remote の確認・Fetch All・
    Daily Refresh（scoop が書くユーザー環境変数を含む）が動くことと、アンインストールで何も残らないことを確認した。
    注意: すでに実在するディレクトリ（旧版が作った %LOCALAPPDATA%\dev.scottlz0310.arbor など）への書き込みは、
    仮想化されず、実フォルダに入る（アンインストールで消えない）。
  -->
  <Properties>
    <DisplayName>Arbor</DisplayName>
    <PublisherDisplayName>scottlz0310</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="ja-jp" />
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="Arbor" Executable="arbor.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Arbor"
        Description="複数のローカル git リポジトリを一元管理し、dsx の実行結果を表示するデスクトップアプリ"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <!-- シェルから arbor で起動できるようにする。エイリアス経由の起動は、呼び出し元のシェルの環境変数
             （BW_SESSION など。Bitwarden の解錠状態）を引き継ぐ。スタートメニューや explorer からの起動は引き継がない -->
        <uap3:Extension Category="windows.appExecutionAlias" Executable="arbor.exe" EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="arbor.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
